# Section 59 forbids committing large checkpoints. The results, plots,
# manifests and configurations that the report is built from are committed;
# the multi-gigabyte artifacts they were derived from are not.

.venv/
__pycache__/
*.py[cod]
.pytest_cache/
*.egg-info/
build/
dist/

# The COCO subset is rebuilt by scripts/build_coco_subset.py from the
# committed split manifest, at the same seed, so the images themselves do
# not need to be in the repository.
data/images/
data/masks/
data/annotations/*.json
data/annotations/*.zip
!data/split_manifest.json

# Training histories are written by every run, including the short smoke
# runs used while developing. Ten one-epoch histories from a 48-image
# sanity check were committed once and read exactly like real results, so
# they are ignored by default and the genuine benchmark histories are
# added deliberately with `git add -f logs/` once the full run completes.
logs/*.json

# Results and figures, for the same reason: they are written by every run,
# including the short ones used while developing and the synthetic ones used
# to prove the table and figure code works before any model had trained.
# The genuine set is added with `git add -f results/ plots/` once the real
# benchmark completes, so a number enters the repository as a decision.
results/*.csv
results/raw/
plots/*.png
confusion_matrices/*.json
predictions/**/*.png

# Trained weights. Section 59 asks that checkpoint access be documented
# instead; the README says where they are.
checkpoints/
yolo_workspace/
*.pt
*.pth

.DS_Store
